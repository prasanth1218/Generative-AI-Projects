# Copy this file to .env and fill in values.

# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/research_agent

# Vector store
CHROMA_PERSIST_DIR=./chroma_store
CHROMA_COLLECTION=enterprise_docs

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LLM provider: "groq" or "mock" (mock needs no key, useful for local dev/demo fallback)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Retrieval tuning
TOP_K=4
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Auth (simple API key for the demo; swap for real JWT later)
APP_API_KEY=dev-local-key

APP_ENV=development
